{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MOBZTree",
  "version": "0.7.0",
  "identifier": "com.mobzystems.mobztree",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MOBZTree",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "cli": {
      "description": "My First CLI",
      "args": [
        {
          "name": "left",
          "index": 1,
          "takesValue": true
        },
        {
          "name": "right",
          "index": 2,
          "takesValue": true
        }
      ]
    }
  }
}